#include "../Common/Pixel/PixelShader2DHeader.hlsli"

// ========================================
// 通常エフェクト（エフェクトなし）
// ========================================
// このシェーダーは何も加工せず、元のテクスチャをそのまま描画します
// ポストエフェクトシステムのデフォルト状態として使用されます
// 
// 用途:
// - ポストエフェクトを無効化する場合
// - デバッグ時に元の画像を確認する場合
// - エフェクトシステムのベースライン測定用
// ========================================
 
float4 main(PS_INPUT PSInput) : SV_TARGET
{
    // テクスチャをそのままサンプリングして返す
    // UV座標に基づいて対応するテクセルの色を取得
    // 
    // 最もシンプルなシェーダーだが、重要な役割:
    // - エフェクトシステムの動作確認
    // - パフォーマンスのベースライン計測
    // - エフェクトのオン/オフ切り替え
    return tex.Sample(texSampler, PSInput.uv);
}